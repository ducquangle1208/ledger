{
  "info": {
    "_postman_id": "5faefbc8-9646-49d2-970e-2f158ec69a91",
    "name": "MiniLedger — Visual Demo",
    "description": "Demo local theo thứ tự: session + CSRF, ownership, faucet, transfer, double-entry, idempotency, rollback và cursor history. Dùng cookie jar mặc định. Mỗi lần chạy tạo hai user mới; không dùng trên hệ thống chứa tiền thật.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{
    "listen": "prerequest",
    "script": { "type": "text/javascript", "exec": [
      "if (pm.request.method === 'POST') {",
      "  pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}/api/v1/auth/csrf'), (error, response) => {",
      "    if (error || response.code !== 200) { throw new Error('Cannot obtain CSRF token'); }",
      "    const csrf = response.json();",
      "    pm.request.headers.upsert({key: csrf.headerName, value: csrf.token});",
      "  });",
      "}"
    ] }
  }],
  "item": [
    {
      "name": "00 — Khởi tạo demo và lấy CSRF",
      "event": [
        {"listen":"prerequest","script":{"type":"text/javascript","exec":[
          "const suffix = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 16);",
          "pm.collectionVariables.clear();",
          "pm.collectionVariables.set('runSuffix', suffix);",
          "pm.collectionVariables.set('faucetKey', `faucet-${suffix}`);",
          "pm.collectionVariables.set('transferKey', `transfer-${suffix}`);"
        ]}},
        {"listen":"test","script":{"type":"text/javascript","exec":[
          "pm.test('CSRF endpoint trả token', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });"
        ]}}
      ],
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/auth/csrf"}
    },
    {
      "name":"01 — Tạo Alice (tự đăng nhập)",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/auth/register","body":{"mode":"raw","raw":"{\"username\":\"alice-{{runSuffix}}\",\"email\":\"alice-{{runSuffix}}@example.com\",\"password\":\"DemoSecret123!\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('Alice được tạo, không lộ hash', () => { pm.response.to.have.status(201); pm.expect(pm.response.json()).not.to.have.property('passwordHash'); });",
        "pm.collectionVariables.set('aliceUserId', String(pm.response.json().id));"
      ]}}]
    },
    {
      "name":"02 — Tạo account Alice",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/accounts","body":{"mode":"raw","raw":"{\"currency\":\"VND\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":[
        "const j = pm.response.json();",
        "pm.test('Account thuộc Alice và balance = 0', () => { pm.response.to.have.status(201); pm.expect(String(j.userId)).to.eql(pm.collectionVariables.get('aliceUserId')); pm.expect(Number(j.balance)).to.eql(0); });",
        "pm.collectionVariables.set('aliceAccountId', String(j.id)); pm.collectionVariables.set('aliceAccountNumber', j.accountNumber);"
      ]}}]
    },
    {
      "name":"03 — Faucet cấp 100.000 VND",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"{{faucetKey}}"}],"url":"{{baseUrl}}/api/v1/faucet/claims","body":{"mode":"raw","raw":"{\"accountId\":{{aliceAccountId}}}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":[
        "const j = pm.response.json();",
        "pm.test('Faucet tạo deposit 100.000', () => { pm.response.to.have.status(201); pm.expect(j.type).to.eql('DEPOSIT'); pm.expect(Number(j.creditBalanceAfter)).to.eql(100000); pm.expect(j.replayed).to.eql(false); });",
        "pm.collectionVariables.set('faucetTransactionId', String(j.transactionId));"
      ]}}]
    },
    {
      "name":"04 — Replay faucet không cấp tiền lần hai",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"{{faucetKey}}"}],"url":"{{baseUrl}}/api/v1/faucet/claims","body":{"mode":"raw","raw":"{\"accountId\":{{aliceAccountId}}}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('Replay cùng transaction', () => { pm.response.to.have.status(200); const j = pm.response.json(); pm.expect(j.replayed).to.eql(true); pm.expect(String(j.transactionId)).to.eql(pm.collectionVariables.get('faucetTransactionId')); });"
      ]}}]
    },
    {
      "name":"05 — Logout Alice",
      "request":{"method":"POST","header":[],"url":"{{baseUrl}}/api/v1/auth/logout"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Logout thành công', () => pm.response.to.have.status(204));"]}}]
    },
    {
      "name":"06 — Tạo Bob (tự đăng nhập)",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/auth/register","body":{"mode":"raw","raw":"{\"username\":\"bob-{{runSuffix}}\",\"email\":\"bob-{{runSuffix}}@example.com\",\"password\":\"DemoSecret123!\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('Bob được tạo', () => pm.response.to.have.status(201)); pm.collectionVariables.set('bobUserId', String(pm.response.json().id));"
      ]}}]
    },
    {
      "name":"07 — Tạo account Bob",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/accounts","body":{"mode":"raw","raw":"{\"currency\":\"VND\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":[
        "const j = pm.response.json();",
        "pm.test('Account thuộc Bob và balance = 0', () => { pm.response.to.have.status(201); pm.expect(String(j.userId)).to.eql(pm.collectionVariables.get('bobUserId')); pm.expect(Number(j.balance)).to.eql(0); });",
        "pm.collectionVariables.set('bobAccountId', String(j.id)); pm.collectionVariables.set('bobAccountNumber', j.accountNumber);"
      ]}}]
    },
    {
      "name":"08 — Bob không thể đọc số dư Alice",
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/balance"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Ẩn account không thuộc user', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().code).to.eql('ACCOUNT_NOT_FOUND'); });"]}}]
    },
    {
      "name":"09 — Logout Bob",
      "request":{"method":"POST","header":[],"url":"{{baseUrl}}/api/v1/auth/logout"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Logout thành công', () => pm.response.to.have.status(204));"]}}]
    },
    {
      "name":"10 — Login Alice",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/auth/login","body":{"mode":"raw","raw":"{\"login\":\"alice-{{runSuffix}}\",\"password\":\"DemoSecret123!\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Đúng session Alice', () => { pm.response.to.have.status(200); pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('aliceUserId')); });"]}}]
    },
    {
      "name":"11 — Chuyển 30.000 từ Alice sang Bob",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"{{transferKey}}"}],"url":"{{baseUrl}}/api/v1/transfers","body":{"mode":"raw","raw":"{\"fromAccountId\":{{aliceAccountId}},\"recipientAccountNumber\":\"{{bobAccountNumber}}\",\"amount\":\"30000.00\",\"description\":\"Demo payment\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":[
        "const j = pm.response.json();",
        "pm.test('Transfer bảo toàn 100.000', () => { pm.response.to.have.status(201); pm.expect(j.replayed).to.eql(false); pm.expect(Number(j.debitBalanceAfter)).to.eql(70000); pm.expect(Number(j.creditBalanceAfter)).to.eql(30000); });",
        "pm.collectionVariables.set('transferTransactionId', String(j.transactionId));"
      ]}}]
    },
    {
      "name":"12 — Receipt có hai bút toán cân bằng",
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/transactions/{{transferTransactionId}}"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('Exact double-entry', () => { pm.response.to.have.status(200); const es = pm.response.json().entries; pm.expect(es).to.have.lengthOf(2); const d = es.find(e => e.entryType === 'DEBIT'); const c = es.find(e => e.entryType === 'CREDIT'); pm.expect(String(d.accountId)).to.eql(pm.collectionVariables.get('aliceAccountId')); pm.expect(String(c.accountId)).to.eql(pm.collectionVariables.get('bobAccountId')); pm.expect(Number(d.amount)).to.eql(30000); pm.expect(Number(c.amount)).to.eql(30000); pm.expect(Number(d.balanceAfter)).to.eql(70000); pm.expect(Number(c.balanceAfter)).to.eql(30000); });"
      ]}}]
    },
    {
      "name":"13 — Replay transfer",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"{{transferKey}}"}],"url":"{{baseUrl}}/api/v1/transfers","body":{"mode":"raw","raw":"{\"fromAccountId\":{{aliceAccountId}},\"recipientAccountNumber\":\"{{bobAccountNumber}}\",\"amount\":\"30000.00\",\"description\":\"Demo payment\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Replay không tạo transaction mới', () => { pm.response.to.have.status(200); const j = pm.response.json(); pm.expect(j.replayed).to.eql(true); pm.expect(String(j.transactionId)).to.eql(pm.collectionVariables.get('transferTransactionId')); });"]}}]
    },
    {
      "name":"14 — Key cũ với amount mới bị conflict",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"{{transferKey}}"}],"url":"{{baseUrl}}/api/v1/transfers","body":{"mode":"raw","raw":"{\"fromAccountId\":{{aliceAccountId}},\"recipientAccountNumber\":\"{{bobAccountNumber}}\",\"amount\":\"31000.00\",\"description\":\"Demo payment\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('IDEMPOTENCY_CONFLICT', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_CONFLICT'); });"]}}]
    },
    {
      "name":"15 — Alice vẫn còn 70.000",
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/balance"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Không trừ thêm tiền', () => { pm.response.to.have.status(200); pm.expect(Number(pm.response.json().balance)).to.eql(70000); });"]}}]
    },
    {
      "name":"16 — History trang đầu",
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/transactions?limit=1"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":[
        "const j = pm.response.json();",
        "pm.test('Transfer mới nhất, còn trang sau', () => { pm.response.to.have.status(200); pm.expect(j.items).to.have.lengthOf(1); pm.expect(String(j.items[0].transactionId)).to.eql(pm.collectionVariables.get('transferTransactionId')); pm.expect(j.hasMore).to.eql(true); pm.expect(j.nextCursor).to.be.a('string').and.not.empty; });",
        "pm.collectionVariables.set('historyCursor', encodeURIComponent(j.nextCursor));"
      ]}}]
    },
    {
      "name":"17 — History trang sau không trùng",
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/transactions?limit=1&cursor={{historyCursor}}"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Trang cuối chứa faucet', () => { pm.response.to.have.status(200); const j = pm.response.json(); pm.expect(j.items).to.have.lengthOf(1); pm.expect(String(j.items[0].transactionId)).to.eql(pm.collectionVariables.get('faucetTransactionId')); pm.expect(j.hasMore).to.eql(false); pm.expect(j.nextCursor).to.eql(null); });"]}}]
    },
    {
      "name":"18 — Same account bị từ chối",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"same-{{runSuffix}}"}],"url":"{{baseUrl}}/api/v1/transfers","body":{"mode":"raw","raw":"{\"fromAccountId\":{{aliceAccountId}},\"recipientAccountNumber\":\"{{aliceAccountNumber}}\",\"amount\":\"10.00\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('SAME_ACCOUNT', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().code).to.eql('SAME_ACCOUNT'); });"]}}]
    },
    {
      "name":"19 — Thiếu Idempotency-Key",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/transfers","body":{"mode":"raw","raw":"{\"fromAccountId\":{{aliceAccountId}},\"recipientAccountNumber\":\"{{bobAccountNumber}}\",\"amount\":\"10.00\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('VALIDATION_ERROR', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'); });"]}}]
    },
    {
      "name":"20 — Logout Alice",
      "request":{"method":"POST","header":[],"url":"{{baseUrl}}/api/v1/auth/logout"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Logout thành công', () => pm.response.to.have.status(204));"]}}]
    },
    {
      "name":"21 — Login Bob",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/auth/login","body":{"mode":"raw","raw":"{\"login\":\"bob-{{runSuffix}}\",\"password\":\"DemoSecret123!\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Đúng session Bob', () => { pm.response.to.have.status(200); pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('bobUserId')); });"]}}]
    },
    {
      "name":"22 — Bob có 30.000",
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/accounts/{{bobAccountId}}/balance"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Balance Bob', () => { pm.response.to.have.status(200); pm.expect(Number(pm.response.json().balance)).to.eql(30000); });"]}}]
    },
    {
      "name":"23 — Không đủ tiền phải rollback",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"failure-{{runSuffix}}"}],"url":"{{baseUrl}}/api/v1/transfers","body":{"mode":"raw","raw":"{\"fromAccountId\":{{bobAccountId}},\"recipientAccountNumber\":\"{{aliceAccountNumber}}\",\"amount\":\"999999.00\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('INSUFFICIENT_FUNDS', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('INSUFFICIENT_FUNDS'); });"]}}]
    },
    {
      "name":"24 — Bob vẫn có 30.000",
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/accounts/{{bobAccountId}}/balance"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Balance Bob không đổi', () => { pm.response.to.have.status(200); pm.expect(Number(pm.response.json().balance)).to.eql(30000); });"]}}]
    },
    {
      "name":"25 — Bob không thể chuyển từ account Alice",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"ownership-{{runSuffix}}"}],"url":"{{baseUrl}}/api/v1/transfers","body":{"mode":"raw","raw":"{\"fromAccountId\":{{aliceAccountId}},\"recipientAccountNumber\":\"{{bobAccountNumber}}\",\"amount\":\"10.00\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Không thể dùng source của người khác', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().code).to.eql('ACCOUNT_NOT_FOUND'); });"]}}]
    },
    {
      "name":"26 — Logout Bob",
      "request":{"method":"POST","header":[],"url":"{{baseUrl}}/api/v1/auth/logout"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Logout thành công', () => pm.response.to.have.status(204));"]}}]
    },
    {
      "name":"27 — Login lại Alice",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/auth/login","body":{"mode":"raw","raw":"{\"login\":\"alice-{{runSuffix}}\",\"password\":\"DemoSecret123!\"}"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Đúng session Alice', () => { pm.response.to.have.status(200); pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('aliceUserId')); });"]}}]
    },
    {
      "name":"28 — Alice vẫn có 70.000 sau các request thất bại",
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/balance"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Balance Alice không đổi', () => { pm.response.to.have.status(200); pm.expect(Number(pm.response.json().balance)).to.eql(70000); });"]}}]
    },
    {
      "name":"29 — Logout kết thúc demo",
      "request":{"method":"POST","header":[],"url":"{{baseUrl}}/api/v1/auth/logout"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Logout thành công', () => pm.response.to.have.status(204));"]}}]
    },
    {
      "name":"30 — API riêng tư yêu cầu đăng nhập",
      "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/accounts"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Session đã bị hủy', () => pm.response.to.have.status(401));"]}}]
    }
  ]
}
