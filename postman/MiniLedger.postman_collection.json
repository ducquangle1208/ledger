    {
      "name": "02 — Deposit và double-entry",
      "description": "Nạp 100.000 VND vào Alice. Hệ thống debit SYSTEM_CASH_VND và credit account Alice trong cùng transaction.",
      "item": [
        {
          "name": "02.1 — Deposit 100.000 VND vào Alice",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Request mới trả HTTP 201', () => pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "pm.test('Deposit hoàn tất đúng dữ liệu', () => {",
                "  pm.expect(json.type).to.eql('DEPOSIT');",
                "  pm.expect(json.status).to.eql('COMPLETED');",
                "  pm.expect(Number(json.amount)).to.eql(100000);",
                "  pm.expect(String(json.creditAccountId)).to.eql(pm.collectionVariables.get('aliceAccountId'));",
                "  pm.expect(Number(json.creditBalanceAfter)).to.eql(100000);",
                "  pm.expect(json.replayed).to.eql(false);",
                "});",
                "pm.collectionVariables.set('depositTransactionId', json.transactionId);",
                "pm.collectionVariables.set('systemCashAccountId', json.debitAccountId);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{depositKey}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": {{aliceAccountId}},\n  \"amount\": \"100000.00\",\n  \"currency\": \"VND\",\n  \"description\": \"Initial demo funding\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/deposits"
          }
        },
        {
          "name": "02.2 — Xem hai ledger entries của deposit",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Deposit có đúng 2 entries đối ứng', () => {",
                "  pm.expect(json.entries).to.be.an('array').with.lengthOf(2);",
                "  const debit = json.entries.find(e => e.entryType === 'DEBIT');",
                "  const credit = json.entries.find(e => e.entryType === 'CREDIT');",
                "  pm.expect(debit).to.exist;",
                "  pm.expect(credit).to.exist;",
                "  pm.expect(String(debit.accountId)).to.eql(pm.collectionVariables.get('systemCashAccountId'));",
                "  pm.expect(String(credit.accountId)).to.eql(pm.collectionVariables.get('aliceAccountId'));",
                "  pm.expect(Number(debit.amount)).to.eql(100000);",
                "  pm.expect(Number(credit.amount)).to.eql(100000);",
                "});",
                "pm.test('Tổng signed entries bằng 0', () => {",
                "  const signedTotal = json.entries.reduce((sum, e) => sum + (e.entryType === 'DEBIT' ? -Number(e.amount) : Number(e.amount)), 0);",
                "  pm.expect(signedTotal).to.eql(0);",
                "});"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/transactions/{{depositTransactionId}}"
          }
        },
        {
          "name": "02.3 — Kiểm tra balance Alice sau deposit",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Balance Alice bằng 100.000', () => {",
                "  pm.expect(String(json.accountId)).to.eql(pm.collectionVariables.get('aliceAccountId'));",
                "  pm.expect(Number(json.balance)).to.eql(100000);",
                "});"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/balance"
          }
        }
      ]
    },
    {
      "name": "03 — Transfer và bảo toàn tiền",
      "description": "Chuyển 30.000 VND từ Alice sang Bob rồi kiểm tra balance và hai ledger entries.",
      "item": [
        {
          "name": "03.1 — Transfer 30.000 VND từ Alice sang Bob",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Request mới trả HTTP 201', () => pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "pm.test('Transfer hoàn tất và trả balance sau giao dịch', () => {",
                "  pm.expect(json.type).to.eql('TRANSFER');",
                "  pm.expect(json.status).to.eql('COMPLETED');",
                "  pm.expect(Number(json.amount)).to.eql(30000);",
                "  pm.expect(String(json.debitAccountId)).to.eql(pm.collectionVariables.get('aliceAccountId'));",
                "  pm.expect(Number(json.debitBalanceAfter)).to.eql(70000);",
                "  pm.expect(String(json.creditAccountId)).to.eql(pm.collectionVariables.get('bobAccountId'));",
                "  pm.expect(Number(json.creditBalanceAfter)).to.eql(30000);",
                "  pm.expect(json.replayed).to.eql(false);",
                "});",
                "pm.collectionVariables.set('transferTransactionId', json.transactionId);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{transferKey}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": {{aliceAccountId}},\n  \"toAccountId\": {{bobAccountId}},\n  \"amount\": \"30000.00\",\n  \"currency\": \"VND\",\n  \"description\": \"Demo payment\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          }
        },
        {
          "name": "03.2 — Xem double-entry của transfer",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Transfer có đúng 2 entries', () => pm.expect(json.entries).to.have.lengthOf(2));",
                "pm.test('DEBIT và CREDIT cân bằng', () => {",
                "  const debit = json.entries.find(e => e.entryType === 'DEBIT');",
                "  const credit = json.entries.find(e => e.entryType === 'CREDIT');",
                "  pm.expect(String(debit.accountId)).to.eql(pm.collectionVariables.get('aliceAccountId'));",
                "  pm.expect(String(credit.accountId)).to.eql(pm.collectionVariables.get('bobAccountId'));",
                "  pm.expect(Number(debit.amount)).to.eql(30000);",
                "  pm.expect(Number(credit.amount)).to.eql(30000);",
                "  pm.expect(Number(debit.balanceAfter)).to.eql(70000);",
                "  pm.expect(Number(credit.balanceAfter)).to.eql(30000);",
                "});"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/transactions/{{transferTransactionId}}"
          }
        },
        {
          "name": "03.3 — Balance Alice = 70.000",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                "pm.test('Alice còn 70.000', () => pm.expect(Number(pm.response.json().balance)).to.eql(70000));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/balance"
          }
        },
        {
          "name": "03.4 — Balance Bob = 30.000",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                "pm.test('Bob có 30.000', () => pm.expect(Number(pm.response.json().balance)).to.eql(30000));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/accounts/{{bobAccountId}}/balance"
          }
        }
      ]
    },
    {
      "name": "04 — Idempotency trực quan",
      "description": "Replay cùng key/payload phải trả cùng transaction mà không chuyển tiền lần hai; dùng cùng key với payload khác phải conflict.",
      "item": [
        {
          "name": "04.1 — Replay cùng key và cùng payload",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Replay trả HTTP 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Server replay đúng movement cũ', () => {",
                "  pm.expect(json.replayed).to.eql(true);",
                "  pm.expect(String(json.transactionId)).to.eql(pm.collectionVariables.get('transferTransactionId'));",
                "  pm.expect(Number(json.debitBalanceAfter)).to.eql(70000);",
                "  pm.expect(Number(json.creditBalanceAfter)).to.eql(30000);",
                "});"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{transferKey}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": {{aliceAccountId}},\n  \"toAccountId\": {{bobAccountId}},\n  \"amount\": \"30000.00\",\n  \"currency\": \"VND\",\n  \"description\": \"Demo payment\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          }
        },
        {
          "name": "04.2 — Xác nhận Alice không bị trừ lần hai",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                "pm.test('Alice vẫn còn 70.000', () => pm.expect(Number(pm.response.json().balance)).to.eql(70000));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/balance"
          }
        },
        {
          "name": "04.3 — Cùng key nhưng amount khác → conflict",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 409 Conflict', () => pm.response.to.have.status(409));",
                "const json = pm.response.json();",
                "pm.test('Error code là IDEMPOTENCY_CONFLICT', () => {",
                "  pm.expect(json.code).to.eql('IDEMPOTENCY_CONFLICT');",
                "  pm.expect(json.details.idempotencyKey).to.eql(pm.collectionVariables.get('transferKey'));",
                "});"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{transferKey}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": {{aliceAccountId}},\n  \"toAccountId\": {{bobAccountId}},\n  \"amount\": \"31000.00\",\n  \"currency\": \"VND\",\n  \"description\": \"Demo payment\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          }
        }
      ]
    },
    {
      "name": "05 — Rollback khi nghiệp vụ thất bại",
      "description": "Chụp balance trước, thử chuyển vượt số dư, sau đó xác nhận cả hai balance không đổi.",
      "item": [
        {
          "name": "05.1 — Chụp balance Alice trước failure",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                "const balance = Number(pm.response.json().balance);",
                "pm.collectionVariables.set('aliceBalanceBeforeFailure', String(balance));",
                "pm.test('Đã lưu balance Alice', () => pm.expect(balance).to.eql(70000));"
              ]
            }
          }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/balance" }
        },
        {
          "name": "05.2 — Chụp balance Bob trước failure",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                "const balance = Number(pm.response.json().balance);",
                "pm.collectionVariables.set('bobBalanceBeforeFailure', String(balance));",
                "pm.test('Đã lưu balance Bob', () => pm.expect(balance).to.eql(30000));"
              ]
            }
          }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/accounts/{{bobAccountId}}/balance" }
        },
        {
          "name": "05.3 — Bob chuyển 999.999 → không đủ tiền",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 409 Conflict', () => pm.response.to.have.status(409));",
                "const json = pm.response.json();",
                "pm.test('Error code là INSUFFICIENT_FUNDS', () => pm.expect(json.code).to.eql('INSUFFICIENT_FUNDS'));"
              ]
