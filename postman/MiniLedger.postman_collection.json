{
  "info": {
    "_postman_id": "5faefbc8-9646-49d2-970e-2f158ec69a91",
    "name": "MiniLedger — Visual Demo",
    "description": "Collection demo trực quan cho MiniLedger. Chạy từ trên xuống dưới với environment `MiniLedger Local`. Mỗi request có assertions để kiểm tra status, balance, double-entry, idempotency và rollback. Kafka, Redis cache, authentication và audit hash-chain không thuộc demo hiện tại.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "runSuffix", "value": "" },
    { "key": "aliceUserId", "value": "" },
    { "key": "bobUserId", "value": "" },
    { "key": "aliceAccountId", "value": "" },
    { "key": "bobAccountId", "value": "" },
    { "key": "aliceAccountNumber", "value": "" },
    { "key": "bobAccountNumber", "value": "" },
    { "key": "depositKey", "value": "" },
    { "key": "depositTransactionId", "value": "" },
    { "key": "systemCashAccountId", "value": "" },
    { "key": "transferKey", "value": "" },
    { "key": "transferTransactionId", "value": "" },
    { "key": "aliceBalanceBeforeFailure", "value": "" },
    { "key": "bobBalanceBeforeFailure", "value": "" }
  ],
  "item": [
    {
      "name": "00 — Khởi tạo phiên demo",
      "description": "Chạy request này đầu tiên. Script tạo suffix và idempotency keys mới, đồng thời xóa ID từ lần chạy trước.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set('runSuffix', suffix);",
              "pm.collectionVariables.set('depositKey', `demo-deposit-${suffix}`);",
              "pm.collectionVariables.set('transferKey', `demo-transfer-${suffix}`);",
              "['aliceUserId','bobUserId','aliceAccountId','bobAccountId','aliceAccountNumber','bobAccountNumber','depositTransactionId','systemCashAccountId','transferTransactionId','aliceBalanceBeforeFailure','bobBalanceBeforeFailure'].forEach(k => pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ứng dụng đang hoạt động', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Health status là UP', () => pm.expect(json.status).to.eql('UP'));",
              "pm.test('Đã tạo dữ liệu phiên demo mới', () => {",
              "  pm.expect(pm.collectionVariables.get('runSuffix')).to.not.be.empty;",
              "  pm.expect(pm.collectionVariables.get('depositKey')).to.include('demo-deposit-');",
              "  pm.expect(pm.collectionVariables.get('transferKey')).to.include('demo-transfer-');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "description": "Xác nhận Spring Boot đã sẵn sàng và khởi tạo biến cho toàn bộ demo."
      }
    },
    {
      "name": "01 — Chuẩn bị người dùng và tài khoản",
      "description": "Tạo Alice, Bob và mỗi người một account VND. Các test tự lưu ID và account number để request sau sử dụng.",
      "item": [
        {
          "name": "01.1 — Tạo Alice",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "pm.test('User response không chứa password', () => {",
                "  pm.expect(json.id).to.be.a('number');",
                "  pm.expect(json.username).to.eql(`alice-${pm.collectionVariables.get('runSuffix')}`);",
                "  pm.expect(json).to.not.have.property('password');",
                "  pm.expect(json).to.not.have.property('passwordHash');",
                "});",
                "pm.collectionVariables.set('aliceUserId', json.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice-{{runSuffix}}\",\n  \"email\": \"alice-{{runSuffix}}@example.com\",\n  \"password\": \"Secret123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/users"
