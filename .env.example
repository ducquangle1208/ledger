# Public deployment. Copy to .env; keep passwords only in the secret file.
COMPOSE_PROJECT_NAME=mini-ledger
APP_DOMAIN=wallet.example.com
POSTGRES_DB=mini_ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
# Set these to the release's registry digests before deploying.
BACKEND_IMAGE=ghcr.io/your-owner/mini-ledger-backend@sha256:REPLACE_WITH_DIGEST
FRONTEND_IMAGE=ghcr.io/your-owner/mini-ledger-frontend@sha256:REPLACE_WITH_DIGEST
